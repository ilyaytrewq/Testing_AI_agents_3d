# Generate independent values; do not reuse your Gemini key as the access key.
APP_ACCESS_KEY=
APP_SESSION_SECRET=
GEMINI_API_KEY=
# Omit DATABASE_URL to use SQLite on the Compose data volume.
# Set it to use an existing PostgreSQL database reachable from the container.
# DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:5432/themed_chat?ssl=verify-full
# Set a CA bundle path inside the container for verify-full.
# PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# Optional: require PostgreSQL and refuse to start if DATABASE_URL is not set.
# APP_DB__BACKEND=postgresql
