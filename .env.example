# Filled in by `make env`: three different random values. Only LLM_API_KEY is yours to set.
# APP_ACCESS_KEY is what you type in the browser (8-255 chars: letters, digits, - and _).
APP_ACCESS_KEY=
APP_SESSION_SECRET=

# The API key of the selected OpenAI-compatible endpoint (Google AI Studio by default).
LLM_API_KEY=
# Only for a topic classifier on another host (guard.classifier_base_url).
# CLASSIFIER_API_KEY=
# Any secret here can instead be a file: NAME_FILE=/path (one trailing newline is dropped).
# Optional overrides of config/app.yaml; set the URL and the model together.
# APP_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# APP_LLM__MODEL=gemini-3.8-flash

# Local Docker Compose only: the password of its PostgreSQL. It goes into DATABASE_URL
# (see compose.local.yaml), so it must be URL-safe: hex from `openssl rand -hex 32`.
# Without Docker, set DATABASE_URL=postgresql+asyncpg://user:password@host:5432/db?ssl=disable
POSTGRES_PASSWORD=
