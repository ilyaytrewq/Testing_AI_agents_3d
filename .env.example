# Use independent values for the application access and session keys.
APP_ACCESS_KEY=
APP_SESSION_SECRET=

# Use the API key issued for the selected OpenAI-compatible endpoint.
LLM_API_KEY=
# Optional Compose overrides; set URL and model together when switching services.
# APP_LLM__BASE_URL=https://klinskoe17.frontierai.ru/v1
# APP_LLM__MODEL=glm-5.3-flash-cb

# Local Docker Compose: use a random hex password (openssl rand -hex 32).
POSTGRES_PASSWORD=
