# Filled in by `make env`: three independent random values.
# APP_ACCESS_KEY is what you type in the browser (8-255 chars: letters, digits, - and _).
APP_ACCESS_KEY=
APP_SESSION_SECRET=

# Local Docker Compose only: use a URL-safe PostgreSQL password (hex from `make env`).
POSTGRES_PASSWORD=

# Fill in all three for your OpenAI-compatible API. Use the base URL without /chat/completions.
APP_LLM__BASE_URL=
APP_LLM__MODEL=
LLM_API_KEY=
# Only for a topic classifier on another host (guard.classifier_base_url).
# CLASSIFIER_API_KEY=
# Any secret here can instead be a file: NAME_FILE=/path (one trailing newline is dropped).

# Without Docker, set the connection string for your PostgreSQL server.
# DATABASE_URL=
