# Generate independent values; do not reuse your Gemini key as the access key.
APP_ACCESS_KEY=
APP_SESSION_SECRET=
# Only the key for the selected LLM provider is required.
GEMINI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=

# Optional Compose overrides for an OpenAI-compatible provider:
# APP_LLM__PROVIDER=openai_compatible
# APP_LLM__BASE_URL=https://YOUR-WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# APP_LLM__MODEL=qwen-plus

# Local Docker Compose: use a random hex password (openssl rand -hex 32).
POSTGRES_PASSWORD=
